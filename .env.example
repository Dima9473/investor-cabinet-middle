APP_MODE=development
PORT=3000

# Режим sandbox: endpoint и токен берутся из secrets/auth.ts (SANDBOX_TOKEN)
TBANK_USE_SANDBOX=false

# T-Invest API: лимиты unary-запросов и стримов котировок — см. developer.tbank.ru/invest/intro/intro
# Эндпоинты: POST /portfolio, /portfolio/positions, /quotes/*, /analysis/portfolio

# GigaChat — Authorization key в secrets/gigachat.ts (Base64, без префикса "Basic ")
# OAuth: POST ngw.devices.sberbank.ru:9443/api/v2/oauth, scope ниже
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_ENABLED=true
# Проверка: GET http://localhost:3000/gigachat/health
